# Hunting rule, not a high-confidence alert: legitimate upload progress bars match too.
alert http any any -> $HTTP_SERVERS any (msg:"PHP2Shell hunting: multipart POST with PHP_SESSION_UPLOAD_PROGRESS"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; nocase; classtype:web-application-attack; sid:9260001; rev:1;)
